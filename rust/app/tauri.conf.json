{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TASurf",
  "version": "1.0.1",
  "identifier": "dev.tasurf.editor",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "shacharrr",
    "homepage": "https://github.com/shacharrr/TASurf",
    "license": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "TAS editor for Counter-Strike: Source surf and bhop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer.nsh"
      }
    }
  }
}
